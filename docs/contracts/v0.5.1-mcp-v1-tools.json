{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "mefinder.mcp.v1",
  "schema_version": "1",
  "release": "0.5.1",
  "server": {
    "name": "mefinder",
    "instructions": "定位原句用 locate_quote；译本或原文对应用 find_parallel_passages：只把既有对齐当召回中心，必须比较源句、前后文与全部候选，按跨语言语义、专名和引文结构校准；anchor_distance 仅表示位置。唯一证据充分才回答 confirmed；多个合理候选回答 ambiguous 并列出；证据不足回答 unavailable，不得硬选或自行翻译。批量核对用 verify_quotes；大意检索用 search_passages，再以 locate_quote 逐字定位；错引比对用 diff_quote；题录补全先读元数据缺口再读书目页；未知文献先用 list_documents；上下文不足用 read_document_window。不得把 PDF 物理页称为正式引用页，不得隐藏多候选歧义。搜索命中只证明文本在本地索引中出现。"
  },
  "terminology": {
    "physical_page": "PDF 文件中的物理位置；索引从 0 开始，不能自动作为正式引用页码。",
    "citation_page": "经现有页码规则确认、可用于引文的页码。",
    "calibrated": "PDF 引用页码已校准或由现有规则验证。",
    "verified": "Word 页码已由现有规则验证。",
    "uncalibrated": "存在物理位置，但没有可安全引用的页码。",
    "unavailable": "当前记录没有可用页码位置。"
  },
  "tools": [
    {
      "name": "list_documents",
      "title": "列出本地文献",
      "description": "按题名、作者、原始文件名或文献类型筛选 MEFinder 已导入文献，返回后续工具使用的稳定 source_file_id。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": ["string", "null"],
            "default": null
          },
          "source_type": {
            "type": "string",
            "enum": ["all", "pdf", "word"],
            "default": "all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "total": {"type": "integer", "minimum": 0},
          "has_more": {"type": "boolean"},
          "documents": {
            "type": "array",
            "items": {"$ref": "#/$defs/document"}
          }
        },
        "required": ["schema_version", "total", "has_more", "documents"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "locate_quote",
      "title": "定位文献原句",
      "description": "在 MEFinder 本地索引中定位引文，返回原文、上下文、匹配方式以及物理页和引用页状态；不替调用方作最终语义裁决。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "mode": {
            "type": "string",
            "enum": ["auto", "exact", "compact", "punctuation", "fuzzy"],
            "default": "auto"
          },
          "source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "source_type": {
            "type": "string",
            "enum": ["all", "pdf", "word"],
            "default": "all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        },
        "required": ["quote"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "query": {"type": "string"},
          "total": {"type": "integer", "minimum": 0},
          "total_is_exact": {"type": "boolean"},
          "has_more": {"type": "boolean"},
          "matches": {
            "type": "array",
            "items": {"$ref": "#/$defs/match"}
          }
        },
        "required": [
          "schema_version",
          "query",
          "total",
          "total_is_exact",
          "has_more",
          "matches"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "read_document_window",
      "title": "读取文献窗口",
      "description": "从 PDF 物理页或 Word 段落的自然位置读取一个有界文本窗口，并保留页码是否可引用的结构化状态。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": ["source_file_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "source": {"$ref": "#/$defs/reader_source"},
          "start": {"type": "integer", "minimum": 0},
          "count": {"type": "integer", "minimum": 1, "maximum": 50},
          "total": {"type": "integer", "minimum": 0},
          "last_position": {"$ref": "#/$defs/nullable_nonnegative_integer"},
          "has_more": {"type": "boolean"},
          "previous_start": {"$ref": "#/$defs/nullable_nonnegative_integer"},
          "next_start": {"$ref": "#/$defs/nullable_nonnegative_integer"},
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/reader_item"}
          }
        },
        "required": [
          "schema_version",
          "source",
          "start",
          "count",
          "total",
          "last_position",
          "has_more",
          "previous_start",
          "next_start",
          "items"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "verify_quotes",
      "title": "批量核对引文",
      "description": "一次核对多条引文是否逐字出现在 MEFinder 本地索引中，为每条返回命中状态（verified 逐字命中 / approximate 疑似错引 / not_found 未找到）与候选原句，用于成批校验一篇论文的引用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "mode": {
            "type": "string",
            "enum": ["auto", "exact", "compact", "punctuation", "fuzzy"],
            "default": "auto"
          },
          "source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "source_type": {
            "type": "string",
            "enum": ["all", "pdf", "word"],
            "default": "all"
          },
          "matches_per_quote": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1
          }
        },
        "required": ["quotes"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "total": {"type": "integer", "minimum": 0},
          "verified_count": {"type": "integer", "minimum": 0},
          "approximate_count": {"type": "integer", "minimum": 0},
          "not_found_count": {"type": "integer", "minimum": 0},
          "results": {
            "type": "array",
            "items": {"$ref": "#/$defs/verify_result"}
          }
        },
        "required": [
          "schema_version",
          "total",
          "verified_count",
          "approximate_count",
          "not_found_count",
          "results"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "diff_quote",
      "title": "错引比对",
      "description": "把一条可能抄错的引文与索引中最接近的原句逐字符对齐，返回原句、相似度以及标注了增（added）/漏（missing）/改（changed）的差异分段；引文完全一致时 status 为 identical。不改写引文，只指出差异。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "source_type": {
            "type": "string",
            "enum": ["all", "pdf", "word"],
            "default": "all"
          },
          "mode": {
            "type": "string",
            "enum": ["auto", "exact", "compact", "punctuation", "fuzzy"],
            "default": "fuzzy"
          }
        },
        "required": ["quote"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "quote": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["identical", "different", "not_found"]
          },
          "match": {
            "anyOf": [
              {"$ref": "#/$defs/match"},
              {"type": "null"}
            ]
          },
          "similarity": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "diff": {
            "type": "array",
            "items": {"$ref": "#/$defs/diff_segment"}
          },
          "stats": {
            "anyOf": [
              {"$ref": "#/$defs/diff_stats"},
              {"type": "null"}
            ]
          }
        },
        "required": [
          "schema_version",
          "quote",
          "status",
          "match",
          "similarity",
          "diff",
          "stats"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "search_passages",
      "title": "按描述检索原文",
      "description": "按自然语言描述或关键词在 MEFinder 本地索引中按相关性召回可能相关的原文段落，用于只记得大意或部分关键词、无法逐字引用时找回原文。这是相关性检索而非逐字核对：命中只表示该段与描述相关，不代表逐字一致；结果按 relevance.rank 排序，relevance.score 仅是本次结果内部的相对相关度（1 最相关），不可跨查询比较。要逐字定位或核对某句话，请改用 locate_quote 或 verify_quotes。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "source_type": {
            "type": "string",
            "enum": ["all", "pdf", "word"],
            "default": "all"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "query": {"type": "string"},
          "total": {"type": "integer", "minimum": 0},
          "total_is_exact": {"type": "boolean"},
          "has_more": {"type": "boolean"},
          "passages": {
            "type": "array",
            "items": {"$ref": "#/$defs/passage"}
          }
        },
        "required": [
          "schema_version",
          "query",
          "total",
          "total_is_exact",
          "has_more",
          "passages"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "find_parallel_passages",
      "title": "查找跨译本对应句",
      "description": "Agent 校准模式：先在 MEFinder 本地索引中定位给定句子，以作品组既有对齐为中心召回附近多个英文、原文或其他译本候选，并返回源句及目标候选的前后文与定位。调用方必须根据跨语言语义、专名、引文结构和上下文重新判断；anchor_distance 只是位置提示，不是正确率。只有唯一候选证据充分时才回答 confirmed；多个候选仍合理时回答 ambiguous 并列出候选；证据不足时回答 unavailable，不得硬选或自行翻译。可按目标文献 ID 或 BCP 47 语言代码收窄。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "mode": {
            "type": "string",
            "enum": ["auto", "exact", "compact", "punctuation", "fuzzy"],
            "default": "auto"
          },
          "source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "target_source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "target_language_code": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
            "default": null
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        },
        "required": ["quote"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "query": {"type": "string"},
          "source_match_count": {"type": "integer", "minimum": 0},
          "source_match_count_is_exact": {"type": "boolean"},
          "total": {"type": "integer", "minimum": 0},
          "candidate_set_count": {"type": "integer", "minimum": 0},
          "has_more": {"type": "boolean"},
          "correspondences": {
            "type": "array",
            "items": {"$ref": "#/$defs/parallel_correspondence"}
          }
        },
        "required": [
          "schema_version",
          "query",
          "source_match_count",
          "source_match_count_is_exact",
          "total",
          "candidate_set_count",
          "has_more",
          "correspondences"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "read_bibliographic_pages",
      "title": "读取版权页候选",
      "description": "返回文献前部与尾部的候选页面文本——版权页、图书在版编目（CIP）页通常出现在这些位置——并对每页标注 ISBN、在版编目、出版社等书目线索，供调用方直接从原书自身文本提取题录，无需联网。只返回既有解析文本，不改写题录，不作最终裁决。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "front": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 5
          },
          "back": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 5
          }
        },
        "required": ["source_file_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "source": {"$ref": "#/$defs/reader_source"},
          "total": {"type": "integer", "minimum": 0},
          "front": {
            "type": "array",
            "items": {"$ref": "#/$defs/bibliographic_page"}
          },
          "back": {
            "type": "array",
            "items": {"$ref": "#/$defs/bibliographic_page"}
          }
        },
        "required": ["schema_version", "source", "total", "front", "back"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "read_bibliographic_metadata",
      "title": "读取题录字段与缺口",
      "description": "返回一篇文献当前已存的题录字段及其取值，并逐字段标注 present（已填）、invalid（存疑，需复核）或 missing（缺失），同时给出文献类型与现有元数据来源。用于在补全题录前看清缺哪些字段；配合 read_bibliographic_pages 从原书自身提取填补。只读现有题录，不改写、不联网、不推断。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "required": ["source_file_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "source": {"$ref": "#/$defs/reader_source"},
          "document_type": {"$ref": "#/$defs/nullable_string"},
          "metadata_source": {"$ref": "#/$defs/nullable_string"},
          "metadata_status": {"$ref": "#/$defs/nullable_string"},
          "fields": {
            "type": "array",
            "items": {"$ref": "#/$defs/bibliographic_field"}
          },
          "missing_fields": {
            "type": "array",
            "items": {"type": "string"}
          },
          "invalid_fields": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": [
          "schema_version",
          "source",
          "document_type",
          "metadata_source",
          "metadata_status",
          "fields",
          "missing_fields",
          "invalid_fields"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "propose_alignment_correction",
      "title": "提议人工对齐修正",
      "description": "当 find_parallel_passages 的既有对齐把某句指到了错误译文段时，用本工具记录一条“待确认”的修正提议：给出源版本、目标版本、源 Segment ID（来自 correspondence.source_segment_ids）与你判断正确的目标 Segment ID（来自候选的 candidate_id），并在 evidence 中写明判断依据（跨语言语义、专名、引文结构、上下文）。本工具只写入待确认记录，绝不改变任何查询结果；必须由用户在对话中明确同意后，再用返回的 confirmation_token 调用 confirm_alignment_correction 才会生效。不得在用户未确认时调用 confirm。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "target_source_file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 200
          },
          "target_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 200
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "source_file_id",
          "target_source_file_id",
          "source_segment_ids",
          "target_segment_ids"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "override_id": {"type": "string"},
          "confirmation_token": {"type": "string"},
          "status": {"const": "pending"},
          "document_group_id": {"type": "string"},
          "source_file_id": {"type": "string"},
          "target_source_file_id": {"type": "string"},
          "source_segments": {
            "type": "array",
            "items": {"$ref": "#/$defs/override_segment"}
          },
          "target_segments": {
            "type": "array",
            "items": {"$ref": "#/$defs/override_segment"}
          },
          "created_at": {"type": "string"}
        },
        "required": [
          "schema_version",
          "override_id",
          "confirmation_token",
          "status",
          "document_group_id",
          "source_file_id",
          "target_source_file_id",
          "source_segments",
          "target_segments",
          "created_at"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "confirm_alignment_correction",
      "title": "确认人工对齐修正",
      "description": "在用户明确同意某条修正提议后，用 propose_alignment_correction 返回的 override_id 与 confirmation_token 使其生效。生效后普通双栏阅读与 MCP 查询都会优先采用这条人工复核对齐，覆盖对应选区的自动结果。若分段或对齐已更新导致提议过期，将返回错误并自动作废该提议。不要在用户未确认时调用本工具。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "override_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "confirmation_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "required": ["override_id", "confirmation_token"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "override_id": {"type": "string"},
          "status": {"const": "confirmed"},
          "source_file_id": {"type": "string"},
          "target_source_file_id": {"type": "string"},
          "confirmed_at": {"type": "string"}
        },
        "required": [
          "schema_version",
          "override_id",
          "status",
          "source_file_id",
          "target_source_file_id",
          "confirmed_at"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "revoke_alignment_correction",
      "title": "撤销人工对齐修正",
      "description": "撤销一条待确认或已确认的人工对齐修正。撤销后该选区恢复使用自动对齐；此操作可逆，用户可随时重新提议并确认。不删除历史记录，只把状态标记为已撤销。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "override_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "required": ["override_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "override_id": {"type": "string"},
          "status": {"const": "revoked"},
          "previous_status": {
            "type": "string",
            "enum": ["pending", "confirmed", "revoked"]
          },
          "source_file_id": {"type": "string"},
          "target_source_file_id": {"type": "string"},
          "revoked_at": {"type": "string"}
        },
        "required": [
          "schema_version",
          "override_id",
          "status",
          "previous_status",
          "source_file_id",
          "target_source_file_id",
          "revoked_at"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "list_alignment_corrections",
      "title": "列出人工对齐修正",
      "description": "只读列出已记录的人工对齐修正（待确认 / 已确认 / 已撤销），含源与目标 Segment ID、判断依据和时间戳，用于复核与审计。可按源文献、目标文献或状态筛选。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "target_source_file_id": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "default": null
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["pending", "confirmed", "revoked", null],
            "default": null
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "1"},
          "total": {"type": "integer", "minimum": 0},
          "overrides": {
            "type": "array",
            "items": {"$ref": "#/$defs/override_record"}
          }
        },
        "required": ["schema_version", "total", "overrides"],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
