  "zotero_source_sync": {
    "note": "0.5.6 新增：来源 → Zotero。只读 Zotero 7 本机 Local API（127.0.0.1:23119），不读写 zotero.sqlite、不走 Zotero Web API、不读取 Zotero 全文索引。偏好走 /api/preferences 的 zotero_sync_enabled / zotero_sync_collections / zotero_sync_frequency。",
    "routes": {
      "GET /api/zotero/overview": {
        "response": {
          "connection": {
            "state": "connected|api_disabled|not_running|unsupported|error",
            "label": "string",
            "message": "string"
          },
          "collections": [
            {
              "key": "string",
              "name": "string",
              "parent": "string|null",
              "item_count": "integer",
              "linked_count": "integer",
              "unsynced_count": "integer"
            }
          ],
          "pdf_parse_mode": {
            "mode": "string",
            "label": "string"
          }
        }
      },
      "GET /api/zotero/status": {
        "response": {
          "phase": "idle|running|paused|done|error",
          "message": "string",
          "rows": [
            {
              "action": "string",
              "title": "string",
              "meta": "string",
              "status_text": "string",
              "tone": "ok|warn|busy|muted"
            }
          ],
          "last_success_at": "string|null",
          "last_attempt_at": "string|null",
          "synced_collections": [
            "string"
          ],
          "documents": {
            "linked": "integer",
            "pending": "integer",
            "unavailable": "integer",
            "failed": "integer"
          }
        }
      },
      "POST /api/zotero/preview": {
        "request": {
          "collections": [
            "string"
          ]
        },
        "response": {
          "known": "boolean",
          "remove_count": "integer|null",
          "unlink_count": "integer|null"
        }
      },
      "POST /api/zotero/sync": {
        "request": {},
        "response": {
          "ok": "boolean",
          "started": "boolean",
          "already_running": "boolean"
        }
      }
    },
    "safety": "只有一次完整、成功的列表对比才会产生移除；连接失败、接口未开、请求失败、分页不完整、所选分类消失、列表与 Zotero 计数矛盾时一律暂停同步，不移除任何文献。"
  }
}
